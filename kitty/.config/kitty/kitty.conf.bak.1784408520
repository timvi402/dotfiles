include ~/.config/omarchy/current/theme/kitty.conf

# Font
font_family JetBrainsMono Nerd Font
bold_italic_font auto
font_size        12.0

# Window
window_padding_width 14
hide_window_decorations yes
confirm_os_window_close 0

# Keybindings
map ctrl+insert copy_to_clipboard
map shift+insert paste_from_clipboard
map ctrl+shift+h show_scrollback
map ctrl+shift+up neighboring_window up
map ctrl+shift+down neighboring_window down
map ctrl+shift+left neighboring_window left
map ctrl+shift+right neighboring_window right
map alt+up neighboring_window up
map alt+down neighboring_window down
map alt+left neighboring_window left
map alt+right neighboring_window right
# Ctrl+å sends CSI-u sequence for the zsh claude-launch widget (å = U+00E5 = 229)
map ctrl+å send_text all \x1b[229;5u

# Allow remote access
allow_remote_control yes

# Scrollback pager (copy mode with nvim)
scrollback_pager nvim -u NONE -c "set nonumber nolist showtabline=0 foldcolumn=0 laststatus=0 termguicolors clipboard=unnamedplus" -c "hi Normal guibg=#1a1b26 guifg=#a9b1d6" -c "hi EndOfBuffer guibg=#1a1b26 guifg=#1a1b26" -c "hi NonText guibg=#1a1b26 guifg=#1a1b26" -c "autocmd TermOpen * normal G" -c "silent write! /tmp/kitty_scrollback_buffer | te cat /tmp/kitty_scrollback_buffer - "

# Aesthetics
cursor_shape block
cursor_blink_interval 0
cursor_trail 1
cursor_trail_decay 0.1 0.4
cursor_trail_start_threshold 1
shell_integration no-cursor
enable_audio_bell no
window_border_width 2pt
active_border_color #7aa2f7
inactive_border_color #414868
draw_minimal_borders yes
inactive_text_alpha 0.30

# Minimal Tab bar styling
tab_bar_edge                bottom
tab_bar_style               powerline
tab_powerline_style         slanted
tab_title_template          {title}{' :{}:'.format(num_windows) if num_windows > 1 else ''}
