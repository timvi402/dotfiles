# Ignore stow conflicts
.DS_Store
*~
*.swp

# ~/.config/kitty is a folded stow symlink into this package, so matugen writes
# its generated palette here. It is derived from the current wallpaper, not
# configuration, and changes on every wallpaper switch.
kitty/.config/kitty/colors-matugen.conf

# ~/.config/nvim/lua/plugins/theme.lua is a symlink Omarchy maintains into
# ~/.local/state/omarchy/current/theme/neovim.lua -- it follows the active
# theme, so it is generated state, not configuration. Stow must not own it.
nvim/.config/nvim/lua/plugins/theme.lua

# Timestamped kitty.conf.bak.<epoch> snapshots. Nothing on this system
# creates these -- they come from editing sessions saving a copy before a
# change, which git already does better. Six had accumulated in the repo
# before they were removed.
kitty/.config/kitty/kitty.conf.bak*
